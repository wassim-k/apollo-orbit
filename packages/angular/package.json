{
  "name": "@apollo-orbit/angular",
  "version": "3.0.0",
  "description": "A full-featured GraphQL client for Angular",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wassim-k/apollo-orbit.git"
  },
  "keywords": [
    "apollo",
    "@apollo/client",
    "angular",
    "ngxs",
    "ngrx",
    "graphql",
    "state",
    "state-management"
  ],
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr --config ./tsconfig.lib.json -p ng-package.json",
    "clean": "rimraf dist",
    "codegen:test": "graphql-codegen --config ./tests/graphql/codegen.ts",
    "types:sync": "tsx ../../scripts/syncApolloTypes.ts",
    "prebuild": "yarn clean && yarn types:sync"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "@apollo/client": ">=4.3.0",
    "graphql": ">=16.0.0",
    "rxjs": ">=7.5.5"
  },
  "dependencies": {
    "@apollo-orbit/core": "^2.2.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/build": "^22.1.7",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "jsdom": "^30.0.1",
    "uuid": "^14.0.2"
  }
}
