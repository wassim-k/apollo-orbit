{
  "name": "@integration/angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:core": "concurrently --raw \"yarn codegen:core --watch\" \"ng serve core\"",
    "start:state": "concurrently --raw \"yarn codegen:state --watch\" \"ng serve state\"",
    "build": "ng build",
    "lint": "ng lint",
    "codegen": "yarn codegen:core && yarn codegen:state",
    "codegen:core": "graphql-codegen --config ./projects/core/codegen.ts",
    "codegen:state": "graphql-codegen --config ./projects/state/codegen.ts",
    "codegen:core:inspect": "node --nolazy --inspect-brk ../../node_modules/@graphql-codegen/cli/bin.js --config ./projects/core/codegen.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/ssr": "^22.1.7",
    "@apollo-orbit/angular": "*",
    "bufferutil": "^4.1.0",
    "crypto-hash": "^4.0.1",
    "express": "^5.2.1",
    "rxjs": "^7.8.2",
    "toastify-js": "1.12.0",
    "tslib": "^2.8.1",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/language-service": "^22.1.5",
    "@apollo-orbit/codegen": "*",
    "@parcel/watcher": "^2.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/toastify-js": "^1.12.4"
  }
}
