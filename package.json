{
  "name": "apollo-orbit",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "lerna run build --scope @apollo-orbit/*",
    "clean": "lerna run clean --scope @apollo-orbit/*",
    "clean:node_modules": "npx rimraf --glob **/node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --cache",
    "prepare": "husky",
    "postinstall": "link-workspaces --silent && node scripts/copySymlinks.js"
  },
  "workspaces": {
    "packages": [
      "integration/*",
      "packages/*"
    ],
    "nohoist": [
      "@integration/angular/@angular/*"
    ]
  },
  "devDependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@apollo/client": "^4.3.0",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@octokit/core": "^7.0.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expect-type": "^1.4.0",
    "graphql": "^17.0.2",
    "graphql-sock": "^1.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lerna": "^10.0.1",
    "link-workspaces": "^1.1.0",
    "lint-staged": "^17.5.0",
    "ng-packagr": "^22.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "zone.js": "^0.16.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix"
    ]
  }
}
